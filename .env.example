# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # 应用标识（任意字符串，如 werewolf-app）
APP_SECRET=               # JWT 会话签名密钥（请用足够长的随机串）

# ── AI 存档加密 ────────────────────────────────────────────────
PRESET_SECRET=            # API Key 存档的 AES-256-GCM 加密密钥（64 位 hex）
                          # 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL 连接串 (mysql://user:pass@host:port/db)
# 桌面客户端（Electron）用本地 SQLite，无需 DATABASE_URL：
# DB_DIALECT=sqlite
# SQLITE_PATH=data/werewolf.db

# ── 桌面客户端 owner 账户（可选）───────────────────────────────
# OWNER_EMAIL=owner@example.com    # 首启自动预建的 owner 账户邮箱
# OWNER_PASSWORD=...               # 首启 owner 初始密码（≥8 位；不设则桌面端随机生成）

# ── AI 调用调优（可选）─────────────────────────────────────────
# AI_TIMEOUT_MS=150000             # 单次调用超时（毫秒）
# AI_DECISION_DEADLINE_MS=260000   # 单个决策点总预算（毫秒）
